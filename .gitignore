# .env only ever contained a public URL in this repo's history (verified
# 2026-08-04, never a secret) — but the repo is PUBLIC and .env was not
# protected: a future variable landing here instead of a new local .env would
# have been published by mistake. Ignored from here on.
.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# YouTube upload credentials/tokens — never commit.
# No file extension anchor on purpose: a real OAuth refresh token was sitting
# in "token.json.bak_pre_analytics", which "token*.json" did not match.
marketing/youtube-upload/client_secret*
marketing/youtube-upload/token*
marketing/youtube-upload/uploaded-log.json
marketing/youtube-upload/auto-upload.log
marketing/youtube-upload/node_modules
marketing/to-publish/*.mp4
marketing/to-publish/*.json
marketing/to-publish/*.x-caption.txt
!marketing/to-publish/README.md
marketing/published/*.mp4
marketing/published/*.json
marketing/published/*.x-caption.txt

# TikTok upload credentials/tokens — never commit
marketing/tiktok-upload/credentials*
marketing/tiktok-upload/uploaded-log.json
marketing/tiktok-upload/auto-upload.log
marketing/tiktok-upload/node_modules

# Instagram upload credentials/tokens — never commit
marketing/instagram-upload/credentials*
marketing/instagram-upload/uploaded-log.json
marketing/instagram-upload/story-log.json
marketing/instagram-upload/auto-upload.log
marketing/instagram-upload/node_modules
marketing/tiktok-upload/telegram_notify_counter.json

# X (Twitter) manual-posting caption generator — logs only, no secrets
marketing/x-upload/generate-captions.log

# Reel generator scratch/output — never commit rendered media
marketing/reel-generator/output/*
!marketing/reel-generator/output/.gitkeep
marketing/reel-generator/generate.log
marketing/reel-generator/__pycache__
marketing/reel-generator/src/__pycache__
marketing/reel-generator/used_backgrounds.json
marketing/reel-generator/run.bat
marketing/reel-generator/.venv

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
marketing/youtube-upload/longform_output/*
!marketing/youtube-upload/longform_output/.gitkeep
marketing/tiktok-upload/run.bat

# Safety net: credential files anywhere in the repo, including renamed copies
# and backups. Rules above are per-folder and easy to miss when a file is
# copied or suffixed; these catch it regardless of location or extension.
**/token.json*
**/token*.json*
**/client_secret*
**/credentials.json*
**/*.pem
**/*.p12
**/*.pfx
**/service-account*.json
.env.local
.env.*.local

# Per-release updater manifest, generated at release time — not source
latest.json

# Social/video assets live outside version control (some exceed GitHub's 100MB limit)
marketing/

# Store packaging and its output: the MSIX is rebuilt from the release binary
# every time, and each one is several megabytes of build product.
msix-build/
*.msix

# Store listing screenshots, recaptured whenever the UI changes.
store-screenshots/

# winget manifests: the copy that matters is the one in microsoft/winget-pkgs.
manifests/
