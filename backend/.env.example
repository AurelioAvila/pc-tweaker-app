# Copy to .env for local development. On Railway, set these as service variables instead.

PORT=3000

# Railway's Postgres plugin fills this in automatically as DATABASE_URL.
DATABASE_URL=postgres://user:password@localhost:5432/pctweaker

# Long random string — e.g. `openssl rand -hex 32`. Never reuse across projects.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (your Tauri app's dev
# and production origins).
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# Stripe — from https://dashboard.stripe.com/apikeys (test mode keys start with sk_test_/pk_test_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Where Stripe sends the browser after checkout. CHECKOUT_SUCCESS_URL should be a
# page you control (can just be a static "you're done, go back to the app" page);
# it does NOT need to be inside the desktop app.
CHECKOUT_SUCCESS_URL=https://example.com/checkout-success
CHECKOUT_CANCEL_URL=https://example.com/checkout-cancel
