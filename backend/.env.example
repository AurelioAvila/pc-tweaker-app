# Copy to .env for local development. On Railway, set these as service variables instead.

PORT=3000

# Railway's Postgres plugin fills this in automatically as DATABASE_URL.
DATABASE_URL=postgres://user:password@localhost:5432/pctweaker

# Long random string — e.g. `openssl rand -hex 32`. Never reuse across projects.
JWT_SECRET=change-me-to-a-long-random-string

# Ed25519 private key (PKCS8 DER, base64) used to sign the desktop app's
# offline-tolerant Pro license check — see src/license.ts. Deliberately
# separate from the Tauri updater's signing key. Generate a new pair with:
#
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');const spki=publicKey.export({type:'spki',format:'der'});console.log('PUBLIC (embed in src-tauri/src/license.rs):',spki.subarray(spki.length-32).toString('base64'));console.log('PRIVATE (this env var):',privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));"
#
# The public half goes into the Rust client, not here.
LICENSE_SIGNING_PRIVATE_KEY=

# Comma-separated list of origins allowed to call this API (your Tauri app's dev
# and production origins).
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# Public base URL of this backend itself — used to build the links inside
# verification/password-reset emails. Set this to your real Railway URL once deployed.
APP_URL=http://localhost:3000

# Email for verification/password-reset links. If neither of these is set,
# emails are logged to the server console instead (fine for local dev, not
# for real users).
#
# RESEND_API_KEY (recommended, especially on Railway/most PaaS hosts): sends
# over HTTPS via https://resend.com — free tier, no signup friction, and not
# affected by hosts that block outbound SMTP ports (587/465), which many do.
RESEND_API_KEY=
MAIL_FROM=PC Tweaker <onboarding@resend.dev>

# SMTP fallback — only used if RESEND_API_KEY is not set. Works fine for
# local development against providers that allow outbound SMTP, but many
# cloud hosts (Railway included) block ports 587/465 outbound, in which case
# this will hang instead of sending. Prefer RESEND_API_KEY above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe — from https://dashboard.stripe.com/apikeys (test mode keys start with sk_test_/pk_test_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Pro subscription prices. Create these in Stripe as RECURRING prices:
#   monthly -> EUR 9.99 / month
#   annual  -> EUR 59   / year
# The app derives the "save 51%" badge from these same two numbers, so if you
# change a price in Stripe, change PRICE_MONTHLY/PRICE_ANNUAL in src/App.tsx too.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Legacy one-time "lifetime" price. Optional: only needed if you still sell it.
STRIPE_PRICE_ID=price_...

# PC Tweaker Uninstaller (annual subscription). The loyalty price is what an
# account with an active PC Tweaker subscription pays — selected server-side,
# never by the client.
STRIPE_PRICE_UNINSTALLER_ANNUAL=price_...
STRIPE_PRICE_UNINSTALLER_LOYALTY=price_...

# Shared secret for server-to-server entitlement lookups from other ecosystem
# backends (PromptShield). Generate with: openssl rand -hex 32
# Unset = the /api/entitlements/check endpoint stays closed.
ECOSYSTEM_API_KEY=

# Where Stripe sends the browser after checkout. CHECKOUT_SUCCESS_URL should be a
# page you control (can just be a static "you're done, go back to the app" page);
# it does NOT need to be inside the desktop app.
CHECKOUT_SUCCESS_URL=https://example.com/checkout-success
CHECKOUT_CANCEL_URL=https://example.com/checkout-cancel

# --- Website support form + reviews ---------------------------------------
# Where the support form's messages are delivered. Server-side only: it is
# never returned by any API response and never shipped in the website bundle.
# Defaults to the maintainer's inbox when unset.
SUPPORT_EMAIL=you@example.com

# Guards the review moderation endpoints (GET /api/reviews/pending and
# PATCH /api/reviews/:id, sent as the `x-admin-token` header). Generate with
# `openssl rand -hex 32`. While unset those routes stay closed and answer 404.
ADMIN_TOKEN=

# The rating collected from testers before the site had a rating form. It is
# folded into the published average as a weighted baseline; keep it honest.
REVIEWS_BASELINE_COUNT=53
REVIEWS_BASELINE_AVG=4.8
