{
  "name": "pc-tweaker-app",
  "private": true,
  "version": "1.6.2",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-quality": "node scripts/audit-i18n.mjs",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "tsc --noEmit && eslint src && prettier --check \"src/**/*.{ts,tsx,css}\" && npm run check:i18n && npm run check:i18n-quality && npm run check:rust && npm run test:advisor && npm run test:thermals",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test:advisor": "node scripts/test-advisor.mjs",
    "test:thermals": "node scripts/test-thermals.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4"
  }
}
